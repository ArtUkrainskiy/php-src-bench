+/* Appends the values after the last used slot of a packed or uninitialized
+ * array. Returns false and leaves the array untouched if they cannot be
+ * stored there. */
+static zend_never_inline bool php_array_push_packed(HashTable *ht, zval *args, uint32_t argc)
+{
+	zend_long next_index = ht->nNextFreeElement == ZEND_LONG_MIN ? 0 : ht->nNextFreeElement;
+	uint32_t room = ht->nTableSize - ht->nNumUsed;
+
+	/* Growing an array with holes may turn it into a hash, so it must already have room. */
+	if (next_index != (zend_long) ht->nNumUsed
+	 || argc > HT_MAX_SIZE - ht->nNumUsed /* nNumUsed + argc must not wrap */
+	 || (argc > room && !HT_IS_WITHOUT_HOLES(ht))) {
+		return false;
+	}
+
+	if (UNEXPECTED(argc > room)) {
+		zend_hash_extend(ht, ht->nNumUsed + argc, true);
+	} else if (HT_FLAGS(ht) & HASH_FLAG_UNINITIALIZED) {
+		zend_hash_real_init_packed(ht);
+	}
+
+	/* ZEND_HASH_FILL_END() resets the internal pointer, array_push() keeps it. */
+	uint32_t pos = ht->nInternalPointer;
+	ZEND_HASH_FILL_PACKED(ht) {
+		for (uint32_t i = 0; i < argc; i++) {
+			Z_TRY_ADDREF(args[i]);
+			ZEND_HASH_FILL_ADD(&args[i]);
+		}
+	} ZEND_HASH_FILL_END();
+	ht->nInternalPointer = pos;
+
+	return true;
+}
