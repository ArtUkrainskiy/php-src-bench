diff --git a/ext/standard/tests/strings/str_search_edges.phpt b/ext/standard/tests/strings/str_search_edges.phpt
new file mode 100644
index 00000000000..27882fc37b7
--- /dev/null
+++ b/ext/standard/tests/strings/str_search_edges.phpt
@@ -0,0 +1,74 @@
+--TEST--
+strpos/str_contains/strstr/substr_count: differential check over randomized inputs
+--FILE--
+<?php
+// Compares the substring-search functions against a naive reference over seeded random
+// inputs. The reference uses substr_compare at fixed offsets, so it does not share the
+// search engine under test. Inputs are shaped to exercise needles with and without a rare
+// byte, all-common needles, lengths straddling the internal thresholds, and present/absent
+// matches in haystacks of several sizes.
+
+function naive_pos(string $h, string $n, int $off = 0): int|false {
+    $hl = strlen($h); $nl = strlen($n);
+    if ($nl === 0) { return $off <= $hl ? $off : false; }
+    for ($i = $off; $i + $nl <= $hl; $i++) {
+        if (substr_compare($h, $n, $i, $nl) === 0) { return $i; }
+    }
+    return false;
+}
+function naive_count(string $h, string $n): int {
+    $hl = strlen($h); $nl = strlen($n); if ($nl === 0) { return 0; }
+    $c = 0; $i = 0;
+    while ($i + $nl <= $hl) {
+        if (substr_compare($h, $n, $i, $nl) === 0) { $c++; $i += $nl; } else { $i++; }
+    }
+    return $c;
+}
+
+$alphabets = [
+    ['a', 'b', 'c'],                                   // tiny: overlaps, all-common
+    str_split('wordx 0123'),                           // common letters + a rare 'x'
+    str_split('the quick brown fox'),                  // words
+    array_map('chr', [0, 1, 2, 9, 10, 32, 65, 97, 122, 127, 200, 255]), // binary + NUL
+];
+
+mt_srand(20261029);
+$fail = 0; $checked = 0;
+
+for ($t = 0; $t < 6000; $t++) {
+    $alpha = $alphabets[mt_rand(0, count($alphabets) - 1)];
+    $n = count($alpha);
+
+    // Haystack size straddles the rare-path routing (64) and the long-needle cap (256).
+    $hl = [0, 1, 20, 63, 64, 65, 200, 300, 2000][mt_rand(0, 8)];
+    $h = '';
+    for ($i = 0; $i < $hl; $i++) { $h .= $alpha[mt_rand(0, $n - 1)]; }
+
+    // Half the time a real substring (present), half an independent needle (usually absent).
+    if ($hl > 0 && mt_rand(0, 1)) {
+        $start = mt_rand(0, $hl - 1);
+        $nl = mt_rand(1, min($hl - $start, 300));
+        $needle = substr($h, $start, $nl);
+    } else {
+        $nl = mt_rand(0, 300);
+        $needle = '';
+        for ($i = 0; $i < $nl; $i++) { $needle .= $alpha[mt_rand(0, $n - 1)]; }
+    }
+
+    $off = $hl > 0 ? mt_rand(0, $hl) : 0;
+
+    if (strpos($h, $needle, $off) !== naive_pos($h, $needle, $off)) { $fail++; }
+    if (str_contains($h, $needle) !== (naive_pos($h, $needle, 0) !== false)) { $fail++; }
+    $want_strstr = ($p = naive_pos($h, $needle, 0)) === false ? false : substr($h, $p);
+    if (strstr($h, $needle) !== $want_strstr) { $fail++; }
+    if ($needle !== '' && substr_count($h, $needle) !== naive_count($h, $needle)) { $fail++; }
+
+    $checked++;
+}
+
+echo "checked $checked\n";
+echo $fail ? "FAILED ($fail)\n" : "ALL OK\n";
+?>
+--EXPECT--
+checked 6000
+ALL OK
diff --git a/ext/standard/tests/strings/str_search_fallback.phpt b/ext/standard/tests/strings/str_search_fallback.phpt
new file mode 100644
index 00000000000..5a19171f282
--- /dev/null
+++ b/ext/standard/tests/strings/str_search_fallback.phpt
@@ -0,0 +1,92 @@
+--TEST--
+strpos: substring search hitting the rare-byte / density-fallback branches
+--FILE--
+<?php
+// Deterministic inputs built to reach each internal branch of the search (rare anchor
+// sparse/dense, the per-window density re-check, the long-needle and few-positions
+// fallbacks, and matches right at the window or haystack boundary). Each result is checked
+// against a naive reference, so the test passes only if behaviour matches the old search.
+
+function naive(string $h, string $n, int $off = 0): int|false {
+    $hl = strlen($h); $nl = strlen($n);
+    if ($nl === 0) { return $off <= $hl ? $off : false; }
+    for ($i = $off; $i + $nl <= $hl; $i++) {
+        if (substr_compare($h, $n, $i, $nl) === 0) { return $i; }
+    }
+    return false;
+}
+
+$cases = [];
+
+// 'z' is a rare anchor byte; 'a'/' ' are common. Haystacks are > needle + 256 so the
+// rare-byte path is taken.
+$pad = str_repeat('a', 2000);
+
+// 1. Rare anchor sparse, match present (win path, no density bail).
+$cases['sparse present'] = [$pad . 'zqw' . $pad, 'zqw'];
+// 2. Rare anchor sparse, absent.
+$cases['sparse absent'] = [$pad . $pad, 'zqw'];
+// 3. Anchor dense from the start -> density bail -> found by fallback.
+$cases['dense then match'] = [str_repeat('z', 100) . 'zqw' . $pad, 'zqw'];
+// 4. Anchor sparse for a full window (16 'z' at 200-byte gaps, above the density gap so the
+//    first window is kept), then dense; absent. Reaches the per-window density re-check.
+$cases['sparse then dense'] = [str_repeat(str_repeat('a', 199) . 'z', 16) . str_repeat('z', 4000), 'zqw'];
+// 4b. Match arriving in the second window, just after a sparse first window.
+$cases['match 2nd window'] = [str_repeat(str_repeat('a', 199) . 'z', 16) . 'zqw' . $pad, 'zqw'];
+// 5. Match exactly at the last valid start position.
+$cases['match at end'] = [$pad . 'zend', 'zend'];
+// 6. Anchor appears once, right at the end.
+$cases['anchor at end'] = [$pad . 'qz', 'qz'];
+// 7. All-common needle (no rare byte) -> best>=common -> original search, present.
+$cases['allcommon present'] = [$pad . 'aaab' . $pad, 'aaab'];
+// 8. Needle longer than 256 (long-needle fallback), present and absent.
+$long = str_repeat('a', 300) . 'z';
+$cases['long present'] = [$pad . $long . $pad, $long];
+$cases['long absent'] = [$pad . $pad, str_repeat('a', 300) . 'q'];
+// 9. Few start positions (haystack barely longer than needle) -> few-positions fallback.
+$cases['few positions'] = [str_repeat('a', 260) . 'z', str_repeat('a', 259) . 'z'];
+// 9b. Long needle (>=9), large haystack (>=1024), few positions -> original Sunday path kept.
+$cases['few long present'] = [str_repeat('a', 1900) . 'z' . str_repeat('a', 147), str_repeat('a', 1900) . 'z'];
+$cases['few long absent'] = [str_repeat('a', 2048), str_repeat('a', 1900) . 'q'];
+// 10. Overlap with a rare anchor.
+$cases['overlap'] = [$pad . 'zzzz' . $pad, 'zzz'];
+// 11. Binary needle with a rare high byte.
+$cases['binary'] = [$pad . "\xffp\x00q" . $pad, "\xffp\x00q"];
+// 12. Both sides of the MIN_SPAN boundary: 'ax' in all-'x' (anchor 'x' is dense), absent.
+$cases['span- (257)'] = [str_repeat('x', 257), 'ax'];
+$cases['span+ (258)'] = [str_repeat('x', 258), 'ax'];
+// 13. Both sides of the boundary with an early match, 6-byte needle.
+$cases['early- (261)'] = ['aaaaax' . str_repeat('a', 255), 'aaaaax'];
+$cases['early+ (262)'] = ['aaaaax' . str_repeat('a', 256), 'aaaaax'];
+
+$fail = 0;
+foreach ($cases as $label => [$h, $n]) {
+    $got = strpos($h, $n);
+    $want = naive($h, $n);
+    $ok = $got === $want;
+    if (!$ok) { $fail++; }
+    printf("%-20s %s\n", $label, $ok ? 'OK' : "DIFF got=" . var_export($got, true) . " want=" . var_export($want, true));
+}
+echo $fail ? "FAILED\n" : "ALL OK\n";
+?>
+--EXPECT--
+sparse present       OK
+sparse absent        OK
+dense then match     OK
+sparse then dense    OK
+match 2nd window     OK
+match at end         OK
+anchor at end        OK
+allcommon present    OK
+long present         OK
+long absent          OK
+few positions        OK
+few long present     OK
+few long absent      OK
+overlap              OK
+binary               OK
+span- (257)          OK
+span+ (258)          OK
+early- (261)         OK
+early+ (262)         OK
+ALL OK
diff --git a/ext/standard/tests/strings/str_search_product_guard.phpt b/ext/standard/tests/strings/str_search_product_guard.phpt
new file mode 100644
index 00000000000..25f95e7d757
--- /dev/null
+++ b/ext/standard/tests/strings/str_search_product_guard.phpt
@@ -0,0 +1,44 @@
+--TEST--
+Substring search across short-input and long-needle routing boundaries
+--FILE--
+<?php
+function reference_position(string $haystack, string $needle): int|false {
+    $last = strlen($haystack) - strlen($needle);
+    for ($i = 0; $i <= $last; $i++) {
+        if (substr_compare($haystack, $needle, $i, strlen($needle)) === 0) {
+            return $i;
+        }
+    }
+    return false;
+}
+$checked = 0;
+$failures = 0;
+foreach ([8, 9, 31, 32, 33, 64, 256] as $length) {
+    $needle = substr(str_repeat('ab', $length), 0, $length - 2) . 'bb';
+    foreach ([255, 256, 1023, 1024, 2047, 2048, 4095, 4096, 8191, 8192, 8193, 16384] as $size) {
+        $base = substr(str_repeat('ab', $size), 0, $size);
+        foreach ([$base, $needle . $base, $base . $needle] as $haystack) {
+            $expected = reference_position($haystack, $needle);
+            $failures += strpos($haystack, $needle) !== $expected;
+            $failures += str_contains($haystack, $needle) !== ($expected !== false);
+            $checked++;
+        }
+    }
+}
+// Everyday UTF-8 inputs that caused premature preprocessing in the broad prototype.
+foreach (['посылка пришла вовремя, упаковка целая. ',
+          'पार्सल समय पर आया और पैकिंग सही थी। '] as $message) {
+    foreach ([1, 4, 32, 256] as $copies) {
+        $haystack = str_repeat($message, $copies);
+        foreach (['спам', 'накрутка подписчиков', 'स्पैम', 'गारंटीकृत लाभ'] as $needle) {
+            $failures += strpos($haystack, $needle) !== reference_position($haystack, $needle);
+            $checked++;
+        }
+    }
+}
+echo "checked $checked\n";
+echo $failures ? "FAILED ($failures)\n" : "ALL OK\n";
+?>
+--EXPECT--
+checked 284
+ALL OK
