diff --git a/ext/pdo_pgsql/tests/stmt_cache_names.phpt b/ext/pdo_pgsql/tests/stmt_cache_names.phpt
new file mode 100644
index 00000000000..9bf7795b594
--- /dev/null
+++ b/ext/pdo_pgsql/tests/stmt_cache_names.phpt
@@ -0,0 +1,57 @@
+--TEST--
+PDO PgSQL statement cache: names unique to the connection, a server statement of the same name is replaced
+--EXTENSIONS--
+pdo_pgsql
+--INI--
+pdo_pgsql.prepare_threshold=1
+--SKIPIF--
+<?php
+require __DIR__ . '/config.inc';
+require __DIR__ . '/../../../ext/pdo/tests/pdo_test.inc';
+PDOTest::skip();
+?>
+--FILE--
+<?php
+require __DIR__ . '/../../../ext/pdo/tests/pdo_test.inc';
+
+function connect() {
+    $db = PDOTest::test_factory(__DIR__ . '/common.phpt');
+    $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
+    $db->setAttribute(PDO::ATTR_EMULATE_PREPARES, false);
+    return $db;
+}
+
+function run(PDO $db) {
+    $stmt = $db->prepare("SELECT 'cached' AS v");
+    $stmt->execute();
+    return $stmt->fetchColumn();
+}
+
+function names(PDO $db) {
+    $db->setAttribute(PDO::ATTR_EMULATE_PREPARES, true);
+    $names = $db->query("SELECT name FROM pg_prepared_statements WHERE name LIKE 'pdo_s_%'")->fetchAll(PDO::FETCH_COLUMN);
+    $db->setAttribute(PDO::ATTR_EMULATE_PREPARES, false);
+    return $names;
+}
+
+$a = connect();
+$b = connect();
+echo run($a), " ", run($b), "\n";
+[$name] = names($a);
+var_dump($name !== names($b)[0]);
+
+$a->exec("DEALLOCATE $name");
+echo "after DEALLOCATE: ", run($a), "\n";
+if (in_array($name, names($a), true)) {
+    $a->exec("DEALLOCATE $name");
+}
+$a->exec("PREPARE $name AS SELECT 'other' AS v");
+echo "after PREPARE of the same name: ", run($a), "\n";
+echo "again: ", run($a), "\n";
+?>
+--EXPECT--
+cached cached
+bool(true)
+after DEALLOCATE: cached
+after PREPARE of the same name: cached
+again: cached
diff --git a/ext/pdo_pgsql/tests/stmt_cache_search_path.phpt b/ext/pdo_pgsql/tests/stmt_cache_search_path.phpt
