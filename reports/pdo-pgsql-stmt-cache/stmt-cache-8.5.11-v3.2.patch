+/* Closes the server statement of a cache entry and forgets it */
+static void pgsql_stmt_cache_close(pdo_pgsql_db_handle *H, pdo_pgsql_cached_stmt *entry)
+{
+	PGresult *res;
+#ifndef HAVE_PQCLOSEPREPARED
+	char q[sizeof("DEALLOCATE ") + sizeof(entry->name)];
+	snprintf(q, sizeof(q), "DEALLOCATE %s", entry->name);
+	res = PQexec(H->server, q);
+#else
+	res = PQclosePrepared(H->server, entry->name);
+#endif
+	if (res) {
+		PQclear(res);
+	}
+	entry->prepared = false;
+	entry->stale = false;
+	entry->uses = 0;
+}
+
+/* Removes the least recently used entry; false if its server statement cannot be closed now */
+static bool pgsql_stmt_cache_evict(pdo_pgsql_db_handle *H)
+{
+	pdo_pgsql_cached_stmt *entry, *victim = NULL;
+	zend_string *key, *victim_key = NULL;
+
+	ZEND_HASH_MAP_FOREACH_STR_KEY_PTR(H->stmt_cache, key, entry) {
+		if (!victim || entry->last_use < victim->last_use) {
+			victim = entry;
+			victim_key = key;
+		}
+	} ZEND_HASH_FOREACH_END();
+
+	if (victim->prepared || victim->stale) {
+		if (PQtransactionStatus(H->server) == PQTRANS_INERROR) {
+			return false;
+		}
+		pgsql_stmt_cache_close(H, victim);
+	}
+	zend_hash_del(H->stmt_cache, victim_key);
+	return true;
+}
+
+/* The connection's statement cache: a statement text with its parameter types runs as an unnamed
+ * statement until it has been executed prepare_threshold times on the connection, then as a named
+ * server statement that is kept until it is evicted or the session is reset. Returns the entry
+ * when its server statement is prepared. */
+static pdo_pgsql_cached_stmt *pgsql_stmt_use_cache(pdo_stmt_t *stmt, pdo_pgsql_stmt *S, int nparams)
+{
+	pdo_pgsql_db_handle *H = S->H;
+	pdo_pgsql_cached_stmt *entry;
+	size_t types_len = nparams * sizeof(Oid);
+	zend_string *key;
+
+	/* the parameter arrays have one element per entry of bound_param_map */
+	if (nparams && (!S->param_types || zend_hash_num_elements(stmt->bound_param_map) < (uint32_t) nparams)) {
+		return NULL;
+	}
+
+	key = zend_string_alloc(ZSTR_LEN(S->query) + 1 + types_len, 0);
+
+	memcpy(ZSTR_VAL(key), ZSTR_VAL(S->query), ZSTR_LEN(S->query) + 1);
+	if (types_len) {
+		memcpy(ZSTR_VAL(key) + ZSTR_LEN(S->query) + 1, S->param_types, types_len);
+	}
+	ZSTR_VAL(key)[ZSTR_LEN(key)] = '\0';
+
+	entry = zend_hash_find_ptr(H->stmt_cache, key);
+	if (!entry) {
+		PHP_SHA256_CTX ctx;
+		unsigned char digest[32];
+
+		if (H->stmt_cache_size <= 0
+				|| (zend_hash_num_elements(H->stmt_cache) >= (uint32_t) H->stmt_cache_size && !pgsql_stmt_cache_evict(H))) {
+			zend_string_release_ex(key, 0);
+			return NULL;
+		}
+		entry = pecalloc(1, sizeof(*entry), H->is_persistent);
+		/* the name is unique to the connection: the key hashed with the connection's random salt */
+		PHP_SHA256Init(&ctx);
+		PHP_SHA256Update(&ctx, H->stmt_cache_salt, sizeof(H->stmt_cache_salt));
+		PHP_SHA256Update(&ctx, (const unsigned char *) ZSTR_VAL(key), ZSTR_LEN(key));
+		PHP_SHA256Final(digest, &ctx);
+		memcpy(entry->name, "pdo_s_", sizeof("pdo_s_") - 1);
+		make_digest_ex(entry->name + sizeof("pdo_s_") - 1, digest, PDO_PGSQL_CACHED_NAME_BYTES);
+		if (H->is_persistent) {
+			zend_string *pkey = zend_string_dup(key, 1);
+
+			zend_hash_add_new_ptr(H->stmt_cache, pkey, entry);
+			zend_string_release_ex(pkey, 1);
+		} else {
+			zend_hash_add_new_ptr(H->stmt_cache, key, entry);
+		}
+	}
+	zend_string_release_ex(key, 0);
+	entry->last_use = ++H->stmt_cache_clock;
+
+	if (!entry->prepared && ++entry->uses >= H->prepare_threshold) {
+		PGresult *res;
+		const char *sqlstate;
+
+		/* a server statement that no longer matches its tables is closed before the name is prepared again */
+		if (entry->stale) {
+			if (PQtransactionStatus(H->server) == PQTRANS_INERROR) {
+				entry->uses = 0;
+				return NULL;
+			}
+			pgsql_stmt_cache_close(H, entry);
+		}
+		res = PQprepare(H->server, entry->name, ZSTR_VAL(S->query), nparams, S->param_types);
+		sqlstate = pdo_pgsql_sqlstate(res);
+
+		/* 42P05: a server statement of this name exists; it is closed and prepared once more */
+		if (sqlstate && !strcmp(sqlstate, "42P05") && PQtransactionStatus(H->server) != PQTRANS_INERROR) {
+			PQclear(res);
+			pgsql_stmt_cache_close(H, entry);
+			res = PQprepare(H->server, entry->name, ZSTR_VAL(S->query), nparams, S->param_types);
+		}
+
+		entry->prepared = PQresultStatus(res) == PGRES_COMMAND_OK;
+		if (!entry->prepared) {
+			entry->uses = 0;
+		}
+		PQclear(res);
+	}
+
+	return entry->prepared ? entry : NULL;
+}
+
+/* 26000: the server statement is gone (session reset); 0A000: its plan no longer matches the tables */
+static bool pgsql_stmt_cache_invalid(PGresult *res)
+{
+	const char *sqlstate = pdo_pgsql_sqlstate(res);
+
+	return sqlstate && (!strcmp(sqlstate, "26000") || !strcmp(sqlstate, "0A000"));
+}
