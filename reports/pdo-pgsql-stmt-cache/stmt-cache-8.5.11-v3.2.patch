+    $stmt = $db->prepare('SELECT * FROM stmt_cache_inv_tx', $options);
+    $stmt->execute();
+    return json_encode($stmt->fetchAll(PDO::FETCH_ASSOC));
+}
+
+function prepared(PDO $db) {
+    return $db->query("SELECT count(*) FROM pg_prepared_statements WHERE statement = 'SELECT * FROM stmt_cache_inv_tx'")->fetchColumn();
+}
+
+foreach ([[], [PDO::ATTR_PREFETCH => 0]] as $options) {
+    $db->exec('ALTER TABLE stmt_cache_inv_tx DROP COLUMN IF EXISTS b');
+    $db->exec('DEALLOCATE ALL');
+    run($db, $options);
+    run($db, $options);
+    run($db, $options);
+    echo "prepared: ", prepared($db), "\n";
+    $db->exec('ALTER TABLE stmt_cache_inv_tx ADD COLUMN b int DEFAULT 2');
+
+    $db->beginTransaction();
+    try {
+        run($db, $options);
+    } catch (PDOException $e) {
+        echo "in a transaction: ", $e->getCode(), "\n";
+    }
+    $db->rollBack();
+
+    $db->beginTransaction();
+    echo "next transaction: ", run($db, $options), " ", run($db, $options), " ", run($db, $options), "\n";
+    $db->commit();
+    echo "prepared: ", prepared($db), "\n";
+}
+
+ini_set('pdo_pgsql.statement_cache_size', 1);
+$db = PDOTest::test_factory(__DIR__ . '/common.phpt');
+$db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
+$db->setAttribute(PDO::ATTR_EMULATE_PREPARES, false);
+$db->exec('CREATE TEMP TABLE stmt_cache_inv_tx (a int)');
+$db->exec('INSERT INTO stmt_cache_inv_tx VALUES (1)');
+run($db);
+run($db);
+$db->exec('ALTER TABLE stmt_cache_inv_tx ADD COLUMN b int DEFAULT 2');
+$db->beginTransaction();
+try {
+    run($db);
+} catch (PDOException $e) {
+    echo "evicted after an error in a transaction: ", $e->getCode(), "\n";
+}
+$db->rollBack();
+$db->prepare('SELECT 1')->execute();
+echo "prepared after eviction: ", prepared($db), "\n";
+$db->beginTransaction();
+echo "next transaction: ", run($db), " ", run($db), " ", run($db), "\n";
+$db->commit();
+?>
+--EXPECT--
+prepared: 1
+in a transaction: 0A000
+next transaction: [{"a":"1","b":"2"}] [{"a":"1","b":"2"}] [{"a":"1","b":"2"}]
+prepared: 1
+prepared: 1
+in a transaction: 0A000
+next transaction: [{"a":"1","b":"2"}] [{"a":"1","b":"2"}] [{"a":"1","b":"2"}]
+prepared: 1
+evicted after an error in a transaction: 0A000
+prepared after eviction: 0
+next transaction: [{"a":"1","b":"2"}] [{"a":"1","b":"2"}] [{"a":"1","b":"2"}]
