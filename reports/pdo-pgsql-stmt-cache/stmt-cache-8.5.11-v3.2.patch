+++ b/ext/pdo_pgsql/tests/stmt_cache_invalidation.phpt
@@ -0,0 +1,53 @@
+--TEST--
+PDO PgSQL statement cache: a server statement that is gone or no longer matches its tables
+--EXTENSIONS--
+pdo_pgsql
+--INI--
+pdo_pgsql.prepare_threshold=1
+--SKIPIF--
+<?php
+require __DIR__ . '/config.inc';
+require __DIR__ . '/../../../ext/pdo/tests/pdo_test.inc';
+PDOTest::skip();
+?>
+--FILE--
+<?php
+require __DIR__ . '/../../../ext/pdo/tests/pdo_test.inc';
+$db = PDOTest::test_factory(__DIR__ . '/common.phpt');
+$db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
+$db->setAttribute(PDO::ATTR_EMULATE_PREPARES, false);
+$db->exec('CREATE TEMP TABLE stmt_cache_inv (a int)');
+$db->exec('INSERT INTO stmt_cache_inv VALUES (1)');
+
+function run(PDO $db, array $options = []) {
+    $stmt = $db->prepare('SELECT * FROM stmt_cache_inv', $options);
+    $stmt->execute();
+    return json_encode($stmt->fetchAll(PDO::FETCH_ASSOC));
+}
+
+echo "cached: ", run($db), "\n";
+$db->exec('ALTER TABLE stmt_cache_inv ADD COLUMN b int DEFAULT 2');
+echo "after ALTER TABLE: ", run($db), "\n";
+$db->exec('DEALLOCATE ALL');
+echo "after DEALLOCATE ALL: ", run($db), "\n";
+$db->exec('DEALLOCATE ALL');
+echo "unbuffered after DEALLOCATE ALL: ", run($db, [PDO::ATTR_PREFETCH => 0]), "\n";
+
+run($db);
+$db->exec('DEALLOCATE ALL');
+$db->beginTransaction();
+try {
+    run($db);
+} catch (PDOException $e) {
+    echo "in a transaction: ", $e->getCode(), "\n";
+}
+$db->rollBack();
+echo "after ROLLBACK: ", run($db), "\n";
+?>
+--EXPECT--
+cached: [{"a":"1"}]
+after ALTER TABLE: [{"a":"1","b":"2"}]
+after DEALLOCATE ALL: [{"a":"1","b":"2"}]
+unbuffered after DEALLOCATE ALL: [{"a":"1","b":"2"}]
+in a transaction: 26000
+after ROLLBACK: [{"a":"1","b":"2"}]
