+--TEST--
+PDO PgSQL statement cache: a cached statement follows the search_path
+--EXTENSIONS--
+pdo_pgsql
+--INI--
+pdo_pgsql.prepare_threshold=1
+--SKIPIF--
+<?php
+require __DIR__ . '/config.inc';
+require __DIR__ . '/../../../ext/pdo/tests/pdo_test.inc';
+PDOTest::skip();
+?>
+--FILE--
+<?php
+require __DIR__ . '/../../../ext/pdo/tests/pdo_test.inc';
+$db = PDOTest::test_factory(__DIR__ . '/common.phpt');
+$db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
+$db->setAttribute(PDO::ATTR_EMULATE_PREPARES, false);
+foreach (['stmt_cache_sp_a', 'stmt_cache_sp_b'] as $schema) {
+    $db->exec("DROP SCHEMA IF EXISTS $schema CASCADE");
+    $db->exec("CREATE SCHEMA $schema");
+    $db->exec("CREATE TABLE $schema.t (v text)");
+    $db->exec("INSERT INTO $schema.t VALUES ('$schema')");
+}
+
+foreach (['stmt_cache_sp_a', 'stmt_cache_sp_b', 'stmt_cache_sp_a'] as $schema) {
+    $db->exec("SET search_path = $schema");
+    $stmt = $db->prepare('SELECT v FROM t');
+    $stmt->execute();
+    echo $schema, ": ", $stmt->fetchColumn(), "\n";
+}
+echo "server statements: ", $db->query("SELECT count(*) FROM pg_prepared_statements WHERE statement = 'SELECT v FROM t'")->fetchColumn(), "\n";
+$db->exec('RESET search_path');
+$db->exec('DROP SCHEMA stmt_cache_sp_a CASCADE');
+$db->exec('DROP SCHEMA stmt_cache_sp_b CASCADE');
+?>
+--EXPECT--
+stmt_cache_sp_a: stmt_cache_sp_a
+stmt_cache_sp_b: stmt_cache_sp_b
+stmt_cache_sp_a: stmt_cache_sp_a
+server statements: 1
diff --git a/ext/pdo_pgsql/tests/stmt_cache_threshold.phpt b/ext/pdo_pgsql/tests/stmt_cache_threshold.phpt
new file mode 100644
index 00000000000..5f3f4e07cfb
--- /dev/null
+++ b/ext/pdo_pgsql/tests/stmt_cache_threshold.phpt
@@ -0,0 +1,46 @@
+--TEST--
+PDO PgSQL statement cache: a statement is prepared on the server from its prepare_threshold-th execution
+--EXTENSIONS--
+pdo_pgsql
+--INI--
+pdo_pgsql.prepare_threshold=3
+--SKIPIF--
+<?php
+require __DIR__ . '/config.inc';
+require __DIR__ . '/../../../ext/pdo/tests/pdo_test.inc';
+PDOTest::skip();
+?>
+--FILE--
+<?php
+require __DIR__ . '/../../../ext/pdo/tests/pdo_test.inc';
+$db = PDOTest::test_factory(__DIR__ . '/common.phpt');
+$db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
+$db->setAttribute(PDO::ATTR_EMULATE_PREPARES, false);
+
+$list = $db->prepare("SELECT name FROM pg_prepared_statements WHERE statement = 'SELECT \$1::int + 1'",
+    [PDO::ATTR_EMULATE_PREPARES => true]);
+
+for ($i = 1; $i <= 4; $i++) {
+    /* a new PDOStatement for every execution, as in one statement per request */
+    $stmt = $db->prepare('SELECT ?::int + 1');
+    $stmt->execute([$i]);
+    $value = $stmt->fetchColumn();
+    unset($stmt);
+    $list->execute();
+    $names = $list->fetchAll(PDO::FETCH_COLUMN);
+    printf("execution %d: %d, server statements: %s\n", $i, $value,
+        implode(', ', array_map(fn ($n) => preg_replace('/^pdo_s_[0-9a-f]{48}$/', 'pdo_s_<sha256>', $n), $names)));
+}
+
+ini_set('pdo_pgsql.prepare_threshold', '0');
+$db = PDOTest::test_factory(__DIR__ . '/common.phpt');
+$stmt = $db->prepare('SELECT ?::int + 2', [PDO::ATTR_EMULATE_PREPARES => false]);
+$stmt->execute([1]);
+echo "threshold 0: ", $db->query("SELECT name FROM pg_prepared_statements WHERE statement = 'SELECT \$1::int + 2'")->fetchColumn(), "\n";
+?>
+--EXPECTF--
+execution 1: 2, server statements: 
+execution 2: 3, server statements: 
+execution 3: 4, server statements: pdo_s_<sha256>
+execution 4: 5, server statements: pdo_s_<sha256>
+threshold 0: pdo_stmt_%x
