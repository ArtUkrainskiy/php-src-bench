+static zend_never_inline var_entries *var_push_new_chunk(php_unserialize_data_t d)
+{
+	var_entries *var_hash = emalloc(sizeof(var_entries));
+	var_hash->used_slots = 0;
+	var_hash->next = 0;
+
+	d->last->next = var_hash;
+	d->last = var_hash;
+
+	if (d->num_chunks == d->chunk_list_capacity) {
+		zend_long new_capacity = d->chunk_list_capacity ? d->chunk_list_capacity * 2 : 4;
+		d->chunk_list = erealloc(d->chunk_list, new_capacity * sizeof(var_entries *));
+		d->chunk_list_capacity = new_capacity;
+	}
+	d->chunk_list[d->num_chunks++] = var_hash;
+	return var_hash;
+}
