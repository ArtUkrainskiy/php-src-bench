#!/usr/bin/env bash
# php-src-bench: A/B micro-benchmarks for php-src.
set -euo pipefail

BENCH_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PARENT="$(dirname "$BENCH_ROOT")"
export BENCH_ROOT
export PHP_SRC="${PHP_SRC:-$PARENT/php-src}"
export BENCH_BUILDS="${BENCH_BUILDS:-$PARENT/php-builds}"

usage() {
	cat <<'USAGE'
php-src-bench: A/B micro-benchmarks for php-src.

Usage:
  bench build [--slim] [--profile P] [--cc LIST] [--no-werror] <name> [<git-ref>|.]
                                     Build a release php CLI of a php-src ref in $BENCH_BUILDS/<name>
                                     ('.' = the php-src working tree as it is now; default: HEAD);
                                     --slim keeps only the binary and its metadata (~55 MB, not ~400);
                                     --profile docker (default: the official Docker image's flags,
                                     -Werror), align, plain or asan; --cc gcc,clang-20 builds
                                     <name>-gcc13, <name>-clang20; an up-to-date build is kept
  bench pr <N> [--cc LIST] [--slim] [--base REF] [--no-merge]
                                     Fetch php-src PR N, merge it onto master and build both
                                     sides as pr<N>-base and pr<N>-head
  bench builds                       List the builds
  bench rm <name>...                 Delete builds
  bench gc [--older-than DAYS] [--yes] [<pattern>...]
                                     List builds with size and age; remove the matching ones with --yes
  bench suites                       List the suites
  bench run <suite> --a <build|php> [--b <build|php>] [options]
                                     Measure a suite and compare B against A, see `bench run --help`
  bench compare <suite> <group>=<A>:<B>... [options]
                                     CPU cycles and instructions per call for pairs of builds, one
                                     group per compiler, alternating passes, A/A control; see
                                     `bench compare --help`
  bench table <series.json> [--full] [--labels FILE]
                                     The change in cycles relative to A, in percent, as Markdown
  bench report new|update|check <dir> [--series S.json]
                                     A report directory for reports/ made from a series, its
                                     generated tables, and the checks before committing it
  bench show <result.json> [--md]    Render a saved result again
  bench difftest <generator> <A> <B> [--seed N] [--count N]
                                     Check that two builds give identical output on generated inputs
  bench mutate <build> <mutations.php> [--only RE]
                                     Mutate the change, rebuild, and see whether the differential
                                     test and the tests catch each mutation
  bench why <suite> <A> <B> --filter RE [--functions f1,f2]
                                     Branch misses, front-end stalls and function addresses of
                                     A and B, for a case whose cycles changed and instructions not
  bench doctor                       What this machine has and lacks for the tool: compilers,
                                     php-src, perf counters, disk, corpus, noise
  bench check [--cpu N]              Report sources of benchmark noise on this machine
  bench tune on|off|status           on: performance governor and no turbo boost, off: back to what
                                     it was (both need sudo), status: show the current settings
  bench php                          Print the php binary that runs the orchestrator

A typical session:
  bench build base master            # the reference
  bench build dev .                  # your working tree
  bench run html --a base --b dev --perf

Environment:
  PHP_SRC                php-src checkout (default: ../php-src next to this directory)
  BENCH_BUILDS           where the builds live (default: ../php-builds)
  BENCH_PHP              php that runs the orchestrator (default: one of the builds, then php in PATH)
  BENCH_CONFIGURE_EXTRA  extra ./configure options for `bench build`
  BENCH_CFLAGS, BENCH_LDFLAGS
                         override the flags of the `bench build` profile
  BENCH_SLIM             1 = every `bench build` is --slim
  BENCH_MIN_FREE_GB      `bench build` refuses to start with less free space (default: 10)
USAGE
}

# bench rm <name>: a full build is a git worktree of php-src, so git has to forget it too;
# a slim build is a plain directory with the binary and its metadata.
remove_build() {
	local name="${1:?usage: bench rm <name>}"
	[[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "bench rm: bad build name: $name" >&2; exit 2; }
	local dir="$BENCH_BUILDS/$name"
	if [[ -e "$dir/.git" ]]; then
		git -C "$PHP_SRC" worktree remove --force "$dir"
	elif [[ -f "$dir/.bench-build.json" ]]; then
		rm -rf -- "$dir"
	else
		echo "bench rm: no such build: $name" >&2
		exit 1
	fi
	git -C "$PHP_SRC" update-ref -d "refs/bench/$name" 2>/dev/null || true
	echo "removed $name"
}

# The orchestrator needs some PHP 8.0+ to run on: BENCH_PHP, else the first build found, else php
# from PATH. It only starts and reads the measured processes, so its own speed does not matter.
runner_php() {
	if [[ -n "${BENCH_PHP:-}" ]]; then
		echo "$BENCH_PHP"
		return
	fi
	local candidate
	# not a debug or sanitizer build: slow, and LeakSanitizer changes exit codes
	for candidate in "$BENCH_BUILDS"/*/sapi/cli/php; do
		[[ -x "$candidate" ]] || continue
		grep -q '"debug": true' "${candidate%/sapi/cli/php}/.bench-build.json" 2>/dev/null && continue
		echo "$candidate"
		return
	done
	if command -v php >/dev/null; then
		command -v php
		return
	fi
	if [[ -x "$PHP_SRC/sapi/cli/php" ]]; then
		echo "$PHP_SRC/sapi/cli/php"
		return
	fi
	echo "bench: no PHP found to run the orchestrator; run 'bench build <name>' or set BENCH_PHP" >&2
	exit 1
}

cmd="${1:-help}"
case "$cmd" in
	build) shift; exec "$BENCH_ROOT/lib/build.sh" "$@" ;;
	tune) shift; exec "$BENCH_ROOT/lib/tune.sh" "$@" ;;
	difftest) shift; exec "$BENCH_ROOT/lib/difftest.sh" "$@" ;;
	pr) shift; exec "$BENCH_ROOT/lib/pr.sh" "$@" ;;
	run|compare|table|report|mutate|why|show|check|doctor|builds|suites)
		php="$(runner_php)"
		exec "$php" -n -d memory_limit=-1 "$BENCH_ROOT/lib/runner.php" "$@"
		;;
	rm) shift; for b in "$@"; do remove_build "$b"; done ;;
	gc) shift; exec "$BENCH_ROOT/lib/gc.sh" "$@" ;;
	php) runner_php ;;
	help|-h|--help) usage ;;
	*) usage >&2; exit 2 ;;
esac
